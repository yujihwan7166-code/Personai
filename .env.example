# Expert Chat Forum — 환경변수 예시
# 사용 방법: 이 파일을 `.env.local` 로 복사한 뒤 값을 채우세요.
# Vercel 배포 시에는 동일 키들을 Vercel 대시보드 → Project Settings → Environment Variables 에 등록하세요.

# ─────────────────────────────────────────────
# 필수 (Required) — 없으면 핵심 기능이 동작하지 않음
# ─────────────────────────────────────────────

# Supabase — 로그인·회원가입·DB·관리자 (Auth.tsx, AuthContext, Admin.tsx)
# 미설정 시 클라이언트가 placeholder URL 로 fetch → "fail to fetch" 에러
# 값 위치: Supabase 대시보드 → Settings → API → Project URL / anon public
# Vite 클라이언트에서 읽으려면 VITE_ prefix 필수
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 개발용 인증 우회 — '1' 이면 로그인 게이트 우회 + mock user 주입.
# 페이지 진입은 통과하지만 Supabase RLS API 호출은 여전히 실패함.
# 프로덕션에서는 반드시 비워둘 것.
VITE_BYPASS_AUTH=

# OpenRouter — LLM 호출 (대부분의 채팅·생성 API 가 의존)
OPENROUTER_API_KEY=

# Serper — 웹 검색 (검색 컨텍스트, 심층 리서치)
SERPER_API_KEY=

# OpenAI 또는 Whisper — 음성 전사 (voice-transcribe, study-transcribe)
# 둘 중 하나 등록하면 됨. OPENAI_API_KEY 가 우선.
OPENAI_API_KEY=
# WHISPER_API_KEY=

# ─────────────────────────────────────────────
# 선택 (Optional) — 특정 모드/기능에서만 사용
# ─────────────────────────────────────────────

# DeepSeek — 일부 모델 라우팅 (사용 안 하면 비워둬도 됨)
DEEPSEEK_API_KEY=

# 의약품 검색 (api/drug-search.ts)
DRUG_API_KEY=

# 한국은행 (BOK) 경제 통계 (api/finance-data.ts)
BOK_API_KEY=

# 금융감독원 (FSS) 데이터 (api/finance-data.ts)
FSS_API_KEY=

# 법제처 OPEN API — 판례/법령 검색 (api/_lib/legal-provider-direct.ts)
# LAW_OC 또는 LAW_API_KEY 둘 중 하나
LAW_OC=
# LAW_API_KEY=

# ─────────────────────────────────────────────
# Legal MCP 브릿지 (api/_lib/legal-provider-mcp.ts)
# 직접 검색 (direct) 모드면 불필요. mcp 모드일 때만.
# ─────────────────────────────────────────────
LEGAL_RESEARCH_PROVIDER=direct  # direct | mcp
LEGAL_MCP_BRIDGE_URL=
LEGAL_MCP_BRIDGE_TOKEN=

# ─────────────────────────────────────────────
# OpenRouter 모델·메타 (오버라이드용 — 비워두면 기본값 사용)
# ─────────────────────────────────────────────
# OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# OPENROUTER_VIDEO_MODEL=google/veo-3.1-fast
# OPENROUTER_PDF_ENGINE=cloudflare-ai
# OPENROUTER_SITE_URL=https://your-domain.com
# OPENROUTER_APP_NAME=Expert Chat Forum

# ─────────────────────────────────────────────
# Sentry — 에러·성능 텔레메트리 (Optional)
# ─────────────────────────────────────────────
# DSN 미설정 시 Sentry.init 자체 skip — 코드는 그대로 통과 (no-op).
# 값 위치: sentry.io → Project → Settings → Client Keys (DSN)
# dev 모드 / VITE_BYPASS_AUTH=1 인 환경은 beforeSend 에서 이벤트 drop.
# VITE_SENTRY_DSN=

# Sentry sourcemap 업로드 (Optional, 빌드 타임) — 셋 다 있어야 활성.
# 미설정 시 sourcemap upload skip, Sentry 캡처는 계속 동작 (minified 스택).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ─────────────────────────────────────────────
# Vercel 자동 주입 (수동 설정 불필요)
# ─────────────────────────────────────────────
# VERCEL_URL          — Vercel 이 배포 URL 자동 주입
# VERCEL_OIDC_TOKEN   — Vercel OIDC 트큰
# NODE_ENV            — production / development

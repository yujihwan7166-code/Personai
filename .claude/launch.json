{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "notesweb",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["vite", "--port", "4321", "--strictPort", "--host", "127.0.0.1"],
      "port": 4321,
      "autoPort": false
    },
    {
      "name": "mockups",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["-y", "serve", "mockups", "-p", "4178", "--no-clipboard"],
      "port": 4178,
      "autoPort": true
    }
  ]
}
